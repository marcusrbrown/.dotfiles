{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@cortexkit/opencode-anthropic-auth@2.17.1",
    "@cortexkit/opencode-openai-auth@1.23.4",
    "@fro.bot/systematic@3.38.5",
    "oh-my-opencode-slim@3.0.7",
    "@cortexkit/opencode-magic-context@0.49.90",
    "@cortexkit/aft-opencode@0.68.1",
    "metacogs@0.4.1"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "oauth": false
    },
    "traces-langfuse": {
      "type": "remote",
      "url": "https://traces.fro.bot/agent/langfuse/api/public/mcp",
      "oauth": false,
      "timeout": 90000,
      "headers": { "Authorization": "Bearer {file:~/.config/infra/traces-reader-workstation.token}" }
    },
    "traces-grafana": {
      "type": "remote",
      "url": "https://traces.fro.bot/agent/grafana/mcp",
      "oauth": false,
      "timeout": 90000,
      "headers": { "Authorization": "Bearer {file:~/.config/infra/traces-reader-workstation.token}" }
    }
  },
  "agent": {
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "experimental": {
    "openTelemetry": false
  },
  "lsp": true,
  "snapshot": false
}
