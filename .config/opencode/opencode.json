{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@cortexkit/opencode-anthropic-auth@2.4.0",
    "@cortexkit/opencode-openai-auth@1.8.0",
    "oh-my-opencode-slim@3.0.6",
    "@cortexkit/opencode-magic-context@0.49.25",
    "@cortexkit/aft-opencode@0.62.0",
    "@fro.bot/systematic@3.27.0",
    "metacogs@0.3.0"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "oauth": false
    }
  },
  "agent": {
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "experimental": {
    "openTelemetry": false
  },
  "lsp": true,
  "snapshot": false
}
