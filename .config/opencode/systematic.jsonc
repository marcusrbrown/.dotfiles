{
  "$schema": "https://fro.bot/systematic/schemas/v3/systematic-config.schema.json",

  // Let a repository define its own `profiles` map in .opencode/systematic.jsonc.
  // User-owned: a project setting this field for itself has it ignored.
  "allow_project_profiles": true,

  // External decision sources for past-work search (`kind: "external"`).
  // A repository proposes its own in-repo sources in .opencode/systematic.jsonc;
  // they are read only for the main roots listed in allow_project_sources.
  // Sources that live in another repository are declared here, per project.
  "search": {
    "allow_project_sources": [
      "~/src/github.com/fro-bot/agent",
      "~/src/github.com/marcusrbrown/infra",
      "~/src/github.com/marcusrbrown/gpt",
      "~/src/github.com/marcusrbrown/sparkle",
      "~/src/github.com/marcusrbrown/ddr",
      "~/src/github.com/marcusrbrown/nr",
      "~/src/github.com/marcusrbrown/panthea"
    ],
    "sources": [
      {
        "name": "fro-bot-wiki",
        "format": "markdown",
        "roots": ["~/src/github.com/fro-bot/.github/knowledge/wiki"],
        "projects": [
          "~/src/github.com/fro-bot/.github",
          "~/src/github.com/fro-bot/agent",
          "~/src/github.com/fro-bot/dashboard",
          "~/src/github.com/fro-bot/space-bus"
        ]
      },
      {
        "name": "infra-runbooks",
        "format": "markdown",
        "roots": ["~/src/github.com/marcusrbrown/infra/docs/runbooks"],
        "projects": [
          "~/src/github.com/fro-bot/.github",
          "~/src/github.com/fro-bot/agent",
          "~/src/github.com/fro-bot/dashboard"
        ]
      },
      {
        "name": "systematic-lessons",
        "format": "markdown",
        "roots": ["~/src/github.com/marcusrbrown/systematic/docs/solutions"],
        "projects": ["~/src/github.com/fro-bot/agent", "~/src/github.com/marcusrbrown/metacogs"]
      }
    ]
  },

  // Default routing when a repository expresses no preference. A project's own
  // `profile` overrides this selection, and when it does, the profile named here
  // is not applied at all.
  "profile": "direct",

  // NOTHING IS SET AT TOP LEVEL ON PURPOSE. A project-defined bundle is advisory
  // per field and per level: it supplies a field only where no user-sourced value
  // exists for that same field at that same level. Routing left in a top-level
  // `categories` or `agents` block would therefore beat any project bundle
  // targeting the same entry, and the project's routing would read as active
  // while changing nothing. Keeping the base empty is what makes a repository's
  // own bundle effective.
  "profiles": {
    // Straight to the vendors, no gateway in front. This is the selection every
    // repository gets unless it names another.
    "direct": {
      "categories": {
        "design": {
          "model": "openai/gpt-6.1-terra",
          "variant": "high"
        },
        "document-review": {
          "model": "anthropic/claude-sonnet-5-5",
          "variant": "high"
        },
        "research": {
          "model": "openai/gpt-6.1-terra",
          "variant": "high"
        },
        "review": {
          "model": "openai/gpt-6.1-terra",
          "variant": "high"
        },
        "workflow": {
          "model": "anthropic/claude-sonnet-5-5",
          "variant": "high"
        }
      },
      "agents": {
        "adversarial-document-reviewer": {
          "model": "openai/gpt-6.1-terra",
          "variant": "high"
        },
        "feasibility-reviewer": {
          "model": "openai/gpt-6.1-terra",
          "variant": "high"
        },
        "repo-research-analyst": {
          "model": "anthropic/claude-sonnet-5-5",
          "variant": "high"
        },
        "spec-flow-analyzer": {
          "model": "openai/gpt-6.1-terra",
          "variant": "high"
        },
        "systematic-implementer": {
          "model": "anthropic/claude-sonnet-5-5",
          "variant": "high"
        }
      }
    }
  }
}
