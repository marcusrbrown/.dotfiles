{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Bun runtime targeting
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "typeRoots": ["../../../.dotfiles/node_modules/@types"],
    "allowImportingTsExtensions": true,

    // `@opencode-ai/sdk` is an optional runtime dependency, dynamically imported
    // so the module loads without it. Resolve its types from the pinned
    // toolchain rather than whatever OpenCode happens to have installed locally
    // -- that ambient copy does not exist in CI.
    // The package is exports-only with no `types`/`main` field, so the mapping
    // must name the declaration entry directly -- a bare directory target
    // fails to resolve and silently falls back to the ambient copy.
    "paths": {
      "@opencode-ai/sdk": ["../../../.dotfiles/node_modules/@opencode-ai/sdk/dist/index.d.ts"]
    },

    // Type checking - strict but practical
    "strict": true,

    // Module behavior
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Output (scripts run directly via bun, no emit needed)
    "noEmit": true,

    // Quality
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts"]
}
