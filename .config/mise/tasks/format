#!/usr/bin/env bash
#MISE description="Format dotfiles"
#MISE dir="{{cwd}}"
set -euo pipefail

PRETTIER="$HOME/.dotfiles/node_modules/.bin/prettier"
if [[ ! -x $PRETTIER ]]; then
  echo "Formatting toolchain is not installed. Run:" >&2
  echo "  bun install --cwd \"\$HOME/.dotfiles\"" >&2
  exit 1
fi

cd "$HOME"
"$PRETTIER" --config .dotfiles/.prettierrc.yaml --write .devcontainer .dotfiles .github
