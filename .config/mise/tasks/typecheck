#!/usr/bin/env bash
#MISE description="Type-check the Bun script projects (.config/opencode/scripts, .claude/scripts)"
#MISE dir="{{cwd}}"
"$HOME/.dotfiles/node_modules/.bin/tsc" --noEmit -p "$HOME/.config/opencode/scripts/tsconfig.json" || exit $?
exec "$HOME/.dotfiles/node_modules/.bin/tsc" --noEmit -p "$HOME/.claude/scripts/tsconfig.json"
