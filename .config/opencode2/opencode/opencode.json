{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@cortexkit/opencode-anthropic-auth@2.17.1",
    "@cortexkit/opencode-openai-auth@1.23.4",
    "@fro.bot/opencode-plugin@0.3.2",
    "@fro.bot/systematic@3.38.5",
    "oh-my-opencode-slim@3.0.7",
    "@cortexkit/opencode-magic-context@0.49.90",
    "@cortexkit/aft-opencode@0.68.1",
    "metacogs@0.4.1"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "protocol": "legacy",
        "codemode": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "oauth": false,
        "protocol": "legacy",
        "codemode": false
      },
      "traces-langfuse": {
        "type": "remote",
        "url": "https://traces.fro.bot/agent/langfuse/api/public/mcp",
        "oauth": false,
        "headers": { "Authorization": "Bearer {file:/Users/mrbrown/.config/infra/traces-reader-workstation.token}" },
        "timeout": { "execution": 90000 },
        "protocol": "legacy",
        "codemode": false
      },
      "traces-grafana": {
        "type": "remote",
        "url": "https://traces.fro.bot/agent/grafana/mcp",
        "oauth": false,
        "headers": { "Authorization": "Bearer {file:/Users/mrbrown/.config/infra/traces-reader-workstation.token}" },
        "timeout": { "execution": 90000 },
        "protocol": "legacy",
        "codemode": false
      }
    }
  },
  "agents": {
    "general": { "disabled": true },
    "explore": { "disabled": true }
  },
  "compaction": { "auto": false },
  "snapshots": false,
  "automations": false,
  "experimental": { "part_rows": false, "video_generate": false },
  "lsp": true,
  "update": "disable",
  "share": "disabled",
  "permissions": [{ "action": "external_directory", "resource": "*", "effect": "ask" }],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "anthropic", "effect": "allow" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ]
}
